@page "/sch0.0-block-4.3"
@layout Migration.Components.Layout.AuthenticatedLayout


<div class="main-content">
    @* header *@
    <div>
        <div class="d-flex align-items-center mb-3">
            <NavLink class="btn btn-outline-secondary btn-sm me-2" @onclick="@(() => navigationManager.NavigateTo("/fsulist"))">
                <i class="fi fi-rr-angle-left fs-15"></i>
            </NavLink>
            <div class="d-flex align-items-center">
                <h3 class="page-heading m-0 me-3">  FSUID: <strong class="me-2">#646465</strong> | SSUID: 1,2,5</h3>
            </div>
        </div>
        <div class="card custom-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-start">
                        <div class="text-center rounded-circle border">
                            <img src="/images/satellite.png" class="rounded-circle" width="40" alt="satellite">
                        </div>
                        <div class="ms-2">
                            <small class="fs-13 mb-0">Coordinate</small>
                            <p class="mb-0 fw-bolder">
                                22.5744° N, 88.3629° E
                            </p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start">
                        <div class="ms-2">
                            <small class="fs-13 mb-0">Timestamp</small>
                            <p class="mb-0 fw-bolder">11 Nov, 2025 - 12:33:06</p>
                        </div>
                    </div>
                    <div class="form-group w-25">
                        <label class="form-label">Switch To Visited Block</label>
                        <select class="form-select form-select-sm w-100">
                            <option value="">Select</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* main-Content *@
    
    @* Block - 4.3 *@
    <div class="card custom-card mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <span class="text-primary fw-bolder me-2">[4.3]</span>List of Sub-divisions of selected SU with population equal to or more than 1500 ( 750 for special cases) and selection and identification of selected Sub-division
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-sm-12">
                    <div class="mb-3">
                        <label class="form-label">
                            <span class="form-badge">1</span>
                            Sample sub-unit (SU) number
                        </label>
                        <input type="text" class="form-control form-control-sm" value="3" disabled>
                    </div>
                </div>
                <div class="col-sm-12">
                    <div class="mb-3">
                        <label class="form-label">
                            <span class="form-badge">1</span>
                            Total number of SDs formed (D1)
                        </label>
                        <input type="text" class="form-control form-control-sm" value="3" disabled>
                    </div>
                </div>
            </div>
        </div>
    </div>


    @* Block - 4.3 *@
    <div class="card custom-card mb-3">
        <div class="card-header">
            <h3 class="card-title">
                <span class="text-primary fw-bolder me-2">[4.3]</span>List of sub-divisions
            </h3>
            <div class="card-tools">
                <button class="btn btn-primary btn-sm"><i class="fi fi-rr-plus me-1"></i>Add</button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Serial no. of Sub-division</th>
                            <th>% of Population in the Sub-division</th>
                            <th>Selected Sub-division</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>
                                <input class="form-control form-control-sm" value="50" disabled>
                            </td>
                            <td>
                                <div class="siteCustomCheckbox">
                                    <label>
                                        <input type="checkbox" />
                                    </label>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>
                                <input class="form-control form-control-sm" value="50" disabled>
                            </td>
                            <td>
                                <div class="siteCustomCheckbox">
                                    <label>
                                        <input type="checkbox" />
                                    </label>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    @* Remark card *@
    <div class="card custom-card">
        <div class="card-header">
            <h3 class="card-title">Remarks</h3>
        </div>
        <div class="card-body">
            <textarea maxlength="500" type="text" class="form-control form-control-sm disabled w-100" placeholder="Enter your remarks here..." rows="2"></textarea>
        </div>
    </div>
</div>

@* Footer *@
<div class="footer pb-3">
    <div class="row">
        <div class="col-sm-6">
            <div class="d-flex">
                <button class="btn btn-outline-secondary" @onclick="@(() => navigationManager.NavigateTo("/sch0.0-block-4.2A"))"><i class="fi fi-rr-angle-left me-1"></i>Back</button>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="d-flex align-items-center justify-content-end">
                <NavLink class="btn btn-primary  me-2"><i class="fi fi-rr-disk me-1"></i>Save</NavLink>
                <NavLink class="btn btn-outline-secondary" href="/sch0.0-block-5">Next<i class="fi fi-rr-angle-right ms-1"></i></NavLink>
            </div>
        </div>
    </div>
</div>


