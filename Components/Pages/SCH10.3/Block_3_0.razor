@page "/sch10.3-block-3_0"
@layout Migration.Components.Layout.AuthenticatedLayout


<div class="main-content">
    <div>
        <div class="d-flex align-items-center mb-3">
            <NavLink class="btn btn-outline-secondary btn-sm me-2" @onclick="@(() => navigationManager.NavigateTo("/sch10.1-block-3"))">
                <i class="fi fi-rr-angle-left fs-15"></i>
            </NavLink>
            <div class="d-flex align-items-center">
                <h3 class="page-heading m-0 me-3">  FSUID: <strong class="me-2">#646465</strong> | SSUID: 1,2,5</h3>
            </div>
        </div>
        <div class="card custom-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-start">
                        <div class="text-center rounded-circle border">
                            <img src="/images/satellite.png" class="rounded-circle" width="40" alt="satellite">
                        </div>
                        <div class="ms-2">
                            <small class="fs-13 mb-0">Coordinate</small>
                            <p class="mb-0 fw-bolder">
                                22.5744° N, 88.3629° E
                            </p>
                        </div>
                    </div>
                    <div class="d-flex align-items-start">
                        <div class="ms-2">
                            <small class="fs-13 mb-0">Timestamp</small>
                            <p class="mb-0 fw-bolder">11 Nov, 2025 - 12:33:06</p>
                        </div>
                    </div>
                    <div class="form-group w-25">
                        <label class="form-label">Switch To Visited Block</label>
                        <select class="form-select form-select-sm w-100" id="exampleFormControlSelect1">
                            <option value="">Select</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* block-3 Migration *@
    <div class="card custom-card">
        <div class="card-header">
            <h3 class="card-title">
                <span class="text-primary me-2">[Block 3.0]</span>Add household members
            </h3>
            <div class="card-tools">
                <div class="d-flex align-items-center">
                    <button class="btn btn-secondary btn-sm me-2">
                        <i class="fi fi-rr-print me-1"></i> Print
                    </button>
                    <button class="btn btn-primary btn-sm"><i class="fi fi-rr-plus me-1"></i>Add</button>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-bordered mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Srl</th>
                            <th>Name</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Alexander</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-outline-primary me-2"><i class="fi fi-rr-pencil"></i></button>
                                    <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#alertModal"><i class="fi fi-rr-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>2</td>
                            <td>Alexander</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <button class="btn btn-outline-primary me-2"><i class="fi fi-rr-pencil"></i></button>
                                    <button class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#alertModal"><i class="fi fi-rr-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="footer pb-3">
    <div class="row">
        <div class="col-sm-6">
            <div class="d-flex">
                <button class="btn btn-outline-secondary" @onclick="@(() => navigationManager.NavigateTo("/sch10.3-block-1"))"><i class="fi fi-rr-angle-left me-1"></i>Back</button>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="d-flex align-items-center justify-content-end">
                <NavLink class="btn btn-primary  me-2 is_sso action"><i class="fi fi-rr-disk me-1"></i>Save</NavLink>
                <NavLink class="btn btn-outline-secondary" @onclick="@(() => navigationManager.NavigateTo("/sch10.3-block-3_1"))">Next<i class="fi fi-rr-angle-right ms-1"></i></NavLink>
            </div>
        </div>
    </div>
</div>
<!-- Alert Modal -->
<div class="modal alert-modal fade" id="alertModal" tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-sm ">
        <div class="modal-content text-center p-4 rounded-4 shadow">

            <!-- Icon -->
            <div class="mb-3">
                <div class="rounded-circle icon-container bg-danger  d-inline-flex align-items-center justify-content-center"
                     style="width:70px;height:70px;">
                    <i class="fi fi-rr-trash text-danger opacity-100 fs-2"></i>
                </div>
            </div>

            <!-- Title -->
            <h5 class="fw-bold mb-2">Are you sure?</h5>

            <!-- Description -->
            <p class="text-muted small mb-4">
                This action cannot be undone.<br>
                Do you really want to delete this record?
            </p>

            <!-- Buttons -->
            <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-light px-4"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-danger px-4">
                    Delete
                </button>
            </div>

        </div>
    </div>
</div>
