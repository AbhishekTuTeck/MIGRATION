@* Footer *@
<div class="footer pb-3">
    <div class="row">
        <div class="col-sm-6">
            <div class="d-flex">
                <button class="btn btn-outline-secondary" @onclick="@(() => navigationManager.NavigateTo("/sch10.3-block-4"))"><i class="fi fi-rr-angle-left me-1"></i>Back</button>
            </div>
