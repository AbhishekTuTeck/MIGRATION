<!-- Block 5 ADD or edit modal Modal -->
<div class="modal fade" id="addBlock5Modal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h1 class="modal-title fs-5">Add Details</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <!-- Serial Number -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label"><span class="form-badge">1</span>Srl no</label>
                            <input type="number" class="form-control form-control-sm" disabled />
                        </div>
                    </div>

                    <!-- Name -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label"><span class="form-badge">2</span>Name of out-migrant member</label>
                            <input type="text" class="form-control form-control-sm" />
                        </div>
                    </div>

                    <!-- Relation -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label"><span class="form-badge">3</span>Relation to head (code)</label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="1">1 - Self</option>
                                <option value="2">2 - Spouse of head</option>
                                <option value="3">3 - Married child</option>
                                <option value="4">4 - Spouse of married child</option>
                                <option value="5">5 - Unmarried child</option>
                                <option value="6">6 - Grand child</option>
                                <option value="7">7 - Father / Mother / Father-in-law / Mother-in-law</option>
                                <option value="8">8 - Brother / Sister / Brother-in-law / Sister-in-law / Other relatives</option>
                                <option value="9">9 - Servant / Employees / Other non-relatives</option>
                            </select>
                        </div>
                    </div>

                    <!-- Gender -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label"><span class="form-badge">4</span>Gender (code)</label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="1">1 - Male</option>
                                <option value="2">2 - Female</option>
                                <option value="3">3 - Transgender</option>
                            </select>
                        </div>
                    </div>

                    <!-- Age -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label"><span class="form-badge">5</span>Age (years)</label>
                            <input class="form-control form-control-sm" type="number" />
                        </div>
                    </div>

                    <!-- Place -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label"><span class="form-badge">6</span>Present place of residence</label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="1">1 - Same state & same district</option>
                                <option value="2">2 - Same state, another district</option>
                                <option value="3">3 - Outside the state</option>
                                <option value="4">4 - Another country</option>
                                <option value="9">9 - Not known</option>
                            </select>
                        </div>
                    </div>

                    <!-- State/UT/Country -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="form-badge">7</span>
                                <span class="fw-bold">For code 3 or 4 in col 6,</span> state /UT/ country of present place of residence (code)
                            </label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Reason -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label"><span class="form-badge">8</span>Reason for migration (code)</label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="01">01 - Search of employment</option>
                                <option value="02">02 - Better employment</option>
                                <option value="03">03 - Business</option>
                                <option value="04">04 - Take up/better employment</option>
                                <option value="05">05 - Transfer of service/contract</option>
                                <option value="06">06 - Near workplace</option>
                                <option value="07">07 - Studies</option>
                                <option value="08">08 - Natural disaster</option>
                                <option value="10">10 - Social/political problems</option>
                                <option value="11">11 - Development displacement</option>
                                <option value="12">12 - Water scarcity</option>
                                <option value="13">13 - Own house/flat</option>
                                <option value="14">14 - Housing problems</option>
                                <option value="15">15 - Health care</option>
                                <option value="16">16 - Post-retirement</option>
                                <option value="17">17 - Marriage</option>
                                <option value="18">18 - Family migration</option>
                                <option value="19">19 - Others</option>
                            </select>
                        </div>
                    </div>

                    <!-- Period -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label"><span class="form-badge">9</span>Period since leaving the household (years)</label>
                            <input type="number" class="form-control form-control-sm" />
                        </div>
                    </div>

                    <!-- Economic activity -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="form-badge">10</span>Whether presently engaged in any economic activity (yes – 1, no – 2, not known - 9)
                            </label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="1">1 - Yes</option>
                                <option value="2">2 - No</option>
                                <option value="9">9 - Not known</option>
                            </select>
                        </div>
                    </div>

                    <!-- Principal activity -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="form-badge">11</span>For code 1 in col 10, principal activity status (code)
                            </label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="11">11 - Worked in HH enterprise (self-employed): Own account worker</option>
                                <option value="12">12 - Employer</option>
                                <option value="21">21 - Worked as helper in HH enterprise (unpaid family worker)</option>
                                <option value="31">31 - Worked as regular salaried / wage employee</option>
                                <option value="41">41 - Worked as casual wage labour: In public works</option>
                                <option value="51">51 - Worked as casual wage labour: In other types of work</option>
                            </select>
                        </div>
                    </div>

                    <!-- NIC -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="form-badge">12</span>For entry in col 11, industry division (2-digit NIC 2025)
                            </label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>

                    <!-- Remittances -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="form-badge">13</span>Whether sent remittances during the last 365 days (yes - 1, no – 2)
                            </label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="1">1 - Yes</option>
                                <option value="2">2 - No</option>
                            </select>
                        </div>
                    </div>

                    <!-- Frequency -->
                    <div class="col-sm-12">
                        <div class="mb-3">
                            <label class="form-label">
                                <span class="form-badge">14</span>Frequency of transfer of remittance (code)
                            </label>
                            <select class="form-select form-select-sm">
                                <option value="">-- Select --</option>
                                <option value="1">1 - Monthly</option>
                                <option value="2">2 - Quarterly</option>
                                <option value="3">3 - Half-yearly</option>
                                <option value="4">4 - Once in a year</option>
                                <option value="9">9 - Infrequent/irregularly</option>
                            </select>
                        </div>
                    </div>

                    <!-- Amount -->
                    <div class="col-sm-12">
                        <div>
                            <label class="form-label">
                                <span class="form-badge">15</span>Amount of remittances sent during the last 365 days (Rs.)
                            </label>
                            <input type="text" class="form-control form-control-sm" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-outline-secondary me-auto" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>


<!-- Alert Modal -->
<div class="modal alert-modal fade" id="alertModal" tabindex="-1"
     data-bs-backdrop="static"
     data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-sm ">
        <div class="modal-content text-center p-4 rounded-4 shadow">

            <!-- Icon -->
            <div class="mb-3">
                <div class="rounded-circle icon-container bg-danger  d-inline-flex align-items-center justify-content-center"
                     style="width:70px;height:70px;">
                    <i class="fi fi-rr-trash text-danger opacity-100 fs-2"></i>
                </div>
            </div>

            <!-- Title -->
            <h5 class="fw-bold mb-2">Are you sure?</h5>

            <!-- Description -->
            <p class="text-muted small mb-4">
                This action cannot be undone.<br>
                Do you really want to delete this record?
            </p>

            <!-- Buttons -->
            <div class="d-flex justify-content-center gap-2">
                <button type="button" class="btn btn-light px-4"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn btn-danger px-4">
                    Delete
                </button>
            </div>

        </div>
    </div>
</div>


